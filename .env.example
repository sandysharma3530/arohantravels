# Public site URL (no trailing slash). Required on Vercel — then Redeploy.
NEXT_PUBLIC_SITE_URL=https://www.smartsquadtravels.com

# Display and dialable phone numbers
NEXT_PUBLIC_BUSINESS_PHONE_DISPLAY=+91 XXXXX XXXXX
NEXT_PUBLIC_BUSINESS_PHONE=+91XXXXXXXXXX
NEXT_PUBLIC_WHATSAPP_NUMBER=91XXXXXXXXXX

# Public email shown in header/footer/contact (optional; falls back to site-config)
NEXT_PUBLIC_BUSINESS_EMAIL=info@yourdomain.com

# Business enquiry inbox (server-only — used by Resend)
BUSINESS_ENQUIRY_EMAIL=enquiries@yourdomain.com

# Resend email delivery (server-only)
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM_EMAIL=Smart Squad Travels <onboarding@resend.dev>

# Optional Google Maps embed URL
NEXT_PUBLIC_MAP_EMBED_URL=

# SEO / Search Console verification (optional)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Marketing analytics (optional — leave blank to disable)
# Prefer GTM alone, or GA4 alone (not both unless intended)
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# ---------------------------------------------------------------------------
# Required on Vercel so enquiries, photo uploads, destinations and blog
# persist without a new deploy. Run supabase/production.sql first.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public Storage bucket for admin photo uploads (created by production.sql)
CMS_UPLOAD_BUCKET=cms-uploads

# Admin dashboard login (server-only — never expose to the browser)
# Visit /sstadmin after setting these and restarting the server.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
ADMIN_SESSION_SECRET=replace-with-a-long-random-string
